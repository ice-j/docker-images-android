# Single source of truth for the image versions.
# Updated automatically by scripts/update-versions.py (see .github/workflows/update.yml).

# https://developer.android.com/studio/#command-line-tools-only
ANDROID_SDK_TOOLS_VERSION=16111833
# https://developer.android.com/tools/releases/platforms
# API level, used as the image tag (e.g. :36, :36-ndk)
ANDROID_PLATFORM_VERSION=37
# installed as "platforms;<package>", space separated
ANDROID_PLATFORM_PACKAGES=android-37.0 android-37.2
# https://developer.android.com/tools/releases/build-tools
ANDROID_BUILD_TOOLS_VERSION=37.0.0
# https://developer.android.com/ndk/downloads
ANDROID_NDK_VERSION=30.0.16248370
# Optional: only follow this NDK major version (e.g. 27 for the r27 LTS).
# Leave empty to always follow the latest stable NDK.
ANDROID_NDK_MAJOR=
